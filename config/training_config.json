{
  "seed": 42,
  "input_size": 640,
  "input_channels": 3,
  "num_classes": 6,
  "base_channels": 48,
  "deep_supervision_weights": {"main": 1.0, "ds1": 0.4, "ds2": 0.2},
  "loss": {
    "focal_tversky_class_params": {"1": [0.3, 0.7, 1.5], "2": [0.3, 0.7, 1.5], "3": [0.7, 0.3, 1.5], "4": [0.4, 0.6, 1.3], "5": [0.2, 0.8, 1.5]},
    "dice": true,
    "ohem_keep_ratio": 0.25,
    "boundary_weight": 0.1,
    "continuity_weight": 0.05
  },
  "optimizer": "AdamW",
  "learning_rate": 0.0001,
  "weight_decay": 0.0001,
  "schedule": "cosine",
  "max_epochs": 80,
  "batch_size": 4,
  "patch_batch_size": 8,
  "patch_size": 256,
  "patch_ratio": 0.40,
  "mixed_precision": true,
  "grad_clip": 1.0,
  "patience": 15,
  "model_selection": "validation macro-Dice (mean Dice of the five non-background classes)",
  "augmentation": {"horizontal_flip": 0.5, "brightness_contrast": {"factor": [0.85, 1.15], "shift": 0.1, "p": 0.7},
                   "gaussian_noise": {"sigma": 0.02, "p": 0.3}, "elastic": {"alpha": 60, "sigma": 8, "p": 0.4}},
  "axial_sampling_mm": 0.009243,
  "locked_epoch_in_the_study": 36,
  "stopped_epoch_in_the_study": 51
}
